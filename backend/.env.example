# 配置模板：复制一份并改名为 .env，再填入你的 Claude API Key
# .env 已经写进 .gitignore，不会被上传到 GitHub；这个模板里不要填真实的 Key

# 在 https://platform.claude.com 创建的 API Key，以 sk-ant- 开头
ANTHROPIC_API_KEY=

# 可选：换模型（例如 claude-haiku-4-5 更便宜），或调整思考深度（low / medium / high）
FOOD_AI_MODEL=claude-opus-5-5
FOOD_AI_EFFORT=low

# 可选：设了之后所有请求都要带 X-App-Key 请求头。本地开发一般不设，方便用 /docs 测试
# APP_SHARED_SECRET=
