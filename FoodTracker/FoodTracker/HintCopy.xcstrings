    },
    "今天还可以生成 %lld 次（和「食谱」页共用次数）。条件不变时重新生成会直接用上次的结果，不占次数。" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld generation left today (shared with the Recipes tab). Regenerating with the same settings reuses the last result and doesn't count."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld generations left today (shared with the Recipes tab). Regenerating with the same settings reuses the last result and doesn't count."
