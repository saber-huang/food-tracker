    },
    "AI 估算食物：你输入、但食物库里没有的那个食物名称（比如「山西过油肉」），只发这个名称。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI food estimates: the name of a food you typed that isn't in the food database (like “Shanxi stir-fried pork”). Only the name is sent."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 估算食物：你输入、但食物库里没有的那个食物名称（比如「山西过油肉」），只发这个名称。"
          }
        }
      }
    },
    "AI 功能" : {
      "localizations" : {
        "en" : {
