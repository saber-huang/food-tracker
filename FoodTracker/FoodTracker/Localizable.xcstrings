    },
    "AI 估算会把你输入的食物名称发给 AI。不想用 AI 的话，可以选一道差不多的菜。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI estimates send the food name you typed to AI. If you'd rather not use AI, pick a similar dish."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 估算会把你输入的食物名称发给 AI。不想用 AI 的话，可以选一道差不多的菜。"
          }
        }
      }
    },
    "AI 估算热量" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI calorie estimate"
          }
        },
        "zh-Hans" : {
