    "%lld 岁以上、BMI 低于 %lld 时，不建议主动减重，因为容易连肌肉一起掉。建议选择「维持」并配合力量训练；如果有体重相关的健康问题，请咨询医生。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over age %1$lld with a BMI below %2$lld, deliberate weight loss isn't recommended because it's easy to lose muscle along with it. Consider choosing Maintain along with strength training, and talk to your doctor about any weight-related health concerns."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上、BMI 低于 %lld 时，不建议主动减重，因为容易连肌肉一起掉。建议选择「维持」并配合力量训练；如果有体重相关的健康问题，请咨询医生。"
          }
        }
      }
    },
    "%lld 岁以上、有高血压或糖尿病，或近一年没查过肾功能的话，按这个蛋白质目标吃之前先问问医生。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you're over %lld, have high blood pressure or diabetes, or haven't had your kidney function checked in the past year, ask your doctor before following this protein target."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上、有高血压或糖尿病，或近一年没查过肾功能的话，按这个蛋白质目标吃之前先问问医生。"
          }
        }
      }
    },
    "%lld 岁以上减脂要格外注意保住肌肉：配合力量训练，开始前先和医生确认。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Over age %lld, take extra care to keep muscle while losing fat: add strength training, and check with your doctor before you start."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上减脂要格外注意保住肌肉：配合力量训练，开始前先和医生确认。"
          }
        }
      }
    },
