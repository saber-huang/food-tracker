    "减脂" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lose Fat"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "减脂"
          }
        }
      }
    },
    "减脂时每公斤体重吃 %@ 克蛋白质。多吃一些蛋白质，有助于在少吃的同时保住肌肉" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When losing fat, eat %@ g of protein per kg of body weight. Extra protein helps you keep muscle while eating less"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
