    "基础代谢公式：Mifflin 等人，1990 年" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BMR equation: Mifflin et al., 1990"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础代谢公式：Mifflin 等人，1990 年"
          }
        }
      }
    },
    "基础代谢是身体一整天躺着不动，维持心跳、呼吸和体温也要消耗的热量。我们用营养学界常用的 Mifflin-St Jeor 公式估算：" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your basal metabolic rate (BMR) is the energy your body uses at complete rest just to keep your heart beating, breathe and stay warm. We estimate it with the widely used Mifflin-St Jeor equation:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基础代谢是身体一整天躺着不动，维持心跳、呼吸和体温也要消耗的热量。我们用营养学界常用的 Mifflin-St Jeor 公式估算："
          }
        }
      }
    },
