    "%lld 岁以上、BMI 低于 %lld 时，不建议主动减重，因为容易连肌肉一起掉。建议选择「维持」并配合力量训练；如果有体重相关的健康问题，请咨询医生。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上、BMI 低于 %lld 时，不建议主动减重，因为容易连肌肉一起掉。建议选择「维持」并配合力量训练；如果有体重相关的健康问题，请咨询医生。"
          }
        }
      }
    },
    "%lld 岁以上、有高血压或糖尿病，或近一年没查过肾功能的话，按这个蛋白质目标吃之前先问问医生。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上、有高血压或糖尿病，或近一年没查过肾功能的话，按这个蛋白质目标吃之前先问问医生。"
          }
        }
      }
    },
    "%lld 岁以上减脂要格外注意保住肌肉：配合力量训练，开始前先和医生确认。" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 岁以上减脂要格外注意保住肌肉：配合力量训练，开始前先和医生确认。"
          }
        }
      }
    },
    "(%@ − 蛋白质 %@ × 4 − 脂肪 %@ × 9) ÷ 4" : {
