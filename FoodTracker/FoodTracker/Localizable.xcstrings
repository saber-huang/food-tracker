            "state" : "translated",
            "value" : "公式最后一项男女不同：男性加 5，女性减 161。"
          }
        }
      }
    },
    "公式用的是公制单位：你的体重 %@ = %@ 公斤，身高 %@ = %@ 厘米。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
